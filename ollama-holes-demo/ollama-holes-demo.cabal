cabal-version:      3.4
name:               ollama-holes-demo

-- The package version.
-- See the Haskell package versioning policy (PVP) for standards
-- guiding when and how versions should be incremented.
-- https://pvp.haskell.org
-- PVP summary:     +-+------- breaking API changes
--                  | | +----- non-breaking API additions
--                  | | | +--- code changes with no API change
version:            0.1.6.0
synopsis: A typed-hole plugin that uses LLMs to generate valid hole-fits
description: This package includes demos for the ollama-holes-plugin library.

license:            MIT
license-file:       ../LICENSE
author:             Matthias Pall Gissurarson <mpg@mpg.is>
maintainer:         Matthias Pall Gissurarson <mpg@mpg.is>
copyright:          2025 (c) Matthias Pall Gissurarson  
category:           Development, Compiler Plugin
tested-with:        GHC == 9.10.*, GHC == 9.12.*
build-type:         Simple
extra-doc-files:    ../CHANGELOG.md
                    ../README.md
homepage:           https://github.com/Tritlo/OllamaHoles

source-repository head
  type:     git
  location: git://github.com/Tritlo/OllamaHoles.git

common warnings
  ghc-options: -Wall
  default-extensions:
    DeriveGeneric
    LambdaCase
    OverloadedStrings

common shared-base
  default-language: GHC2021
  build-depends:
      base >= 4.18 && < 4.22
    , ollama-holes-plugin
    , aeson ^>= 2.2
    , bytestring >= 0.11.5 && < 0.13
    , containers >= 0.6 && < 0.8
    , crypton >= 1.1.2
    , directory >= 1.3.8 && < 1.4
    , filepath >= 1.4.2 && < 1.6
    , ghc >= 9.6 && < 9.14
    , mtl >= 2.2 && < 2.4
    , random >= 1.2 && < 1.4
    , text >= 2.0 && < 2.2
    , time >= 1.12 && < 1.15
    , toml-parser >= 2.0.2
    , transformers >= 0.5.6 && < 0.7
    , vector >= 0.13.0 && < 0.14

common backend-deps
  build-depends:
      modern-uri ^>= 0.3
    , ollama-haskell ^>= 0.1
    , req ^>= 3.13



executable ollama-holes-demo
  hs-source-dirs:      Test
  main-is:             Main.hs
  default-language:    GHC2021
  build-depends:
      base >= 4 && < 5
    , ollama-holes-plugin

executable ollama-holes-config-demo
  main-is:          ConfigDemo.hs
  hs-source-dirs:   demo-config
  default-language: GHC2021
  build-depends:
      base
    , ollama-holes-plugin
